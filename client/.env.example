VITE_API_URL=http://localhost:3001

# Supabase — required for real auth in production
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# If VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are omitted, the app falls back
# to the dev-bypass token flow (works without a Supabase project in local dev).
